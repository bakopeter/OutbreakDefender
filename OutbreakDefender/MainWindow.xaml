<Window x:Class="OutbreakDefender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OutbreakDefender"
        mc:Ignorable="d"
        Title="MainWindow" Height="810" Width="1200">

    <Window.Resources>
        <!-- 3. pluszfeladat: közös gombstílus -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#162238"/>
            <Setter Property="BorderBrush" Value="#B9C6D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnKeret"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnKeret" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnKeret" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Statisztika-kártya a felső sávhoz -->
        <Style x:Key="StatKartya" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#B9C6D8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 1. FEJLÉC ==================== -->
        <!--Fejléc-->
        <Border Grid.Row="0" Background="#162238" Padding="20,10">
            <StackPanel>
                <TextBlock Text="OUTBREAK DEFENDER" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Járványvédelmi stratégiai játék" Foreground="#9FB3CC"/>
            </StackPanel>
        </Border>

        <!-- ==================== 2. STATISZTIKA- ÉS VEZÉRLŐSÁV ==================== -->
        <Border Grid.Row="1" Background="#DDE6F0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Kör -->
                <Border Grid.Column="0" Style="{StaticResource StatKartya}">
                    <StackPanel>
                        <TextBlock Text="Kör" FontSize="11" Foreground="#5B7089"/>
                        <TextBlock x:Name="txtKor" Text="1"
                                   FontSize="18" FontWeight="Bold" Foreground="#162238"/>
                    </StackPanel>
                </Border>

                <!-- Akciópont -->
                <Border Grid.Column="1" Style="{StaticResource StatKartya}">
                    <StackPanel>
                        <TextBlock Text="Akciópont" FontSize="11" Foreground="#5B7089"/>
                        <TextBlock x:Name="txtAkcioPont" Text="10"
                                   FontSize="18" FontWeight="Bold" Foreground="#162238"/>
                    </StackPanel>
                </Border>

                <!-- Érintett lakosság -->
                <Border Grid.Column="2" Style="{StaticResource StatKartya}">
                    <StackPanel>
                        <TextBlock Text="Érintett lakosság (összesen)" FontSize="11" Foreground="#5B7089"/>
                        <TextBlock x:Name="txtErintettLakossag" Text="0"
                                   FontSize="18" FontWeight="Bold" Foreground="#162238"/>
                    </StackPanel>
                </Border>

                <!-- Fertőzöttek -->
                <Border Grid.Column="3" Style="{StaticResource StatKartya}">
                    <StackPanel>
                        <TextBlock Text="Fertőzöttek (összesen)" FontSize="11" Foreground="#5B7089"/>
                        <TextBlock x:Name="txtFertozottek" Text="0 (0,0%)"
                                   FontSize="18" FontWeight="Bold" Foreground="#D32F2F"/>
                    </StackPanel>
                </Border>

                <!-- Gombok és nehézségi szint -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnKovetkezoKor" Content="▶ Következő kör" 
                            Click="BtnKovetkezoKor_Click"/>
                    <Button x:Name="btnUjJatek" Content="↻ Új játék"
                            Click="BtnUjJatek_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 3. FŐ TERÜLET: VÁROSOK + AKCIÓK ==================== -->
        <Grid Grid.Row="2" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Várostáblázat -->
            <Border Grid.Column="0" Background="White" CornerRadius="8"
                    BorderBrush="#B9C6D8" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🏙 Városok"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#162238" Margin="4,2,0,8"/>

                    <!-- DataGrid: a városok táblázatos megjelenítése -->
                    <DataGrid x:Name="dgVarosok" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Padding="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Város" Binding="{Binding Nev}"/>
                            <DataGridTextColumn Header="Lakosság" Binding="{Binding Lakossag, StringFormat={}{0:N0}}"/>
                            <DataGridTemplateColumn Header="Fertőzöttség">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ProgressBar Padding="5" Minimum="0" Maximum="100" Height="18" Width="160" Value="{Binding Fertozottseg}"/>
                                            <TextBlock Padding="5" Text="{Binding Fertozottseg, StringFormat={}{0}%}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Védelem" Binding="{Binding Vedelem}"/>
                            <DataGridCheckBoxColumn Header="Karantén" Binding="{Binding Karanten}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Akciópanel -->
            <Border Grid.Column="1" Background="White" CornerRadius="8"
                    BorderBrush="#B9C6D8" BorderThickness="1"
                    Padding="10" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="⚕ Akciók"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#162238" Margin="4,2,0,8"/>

                    <!-- Kezelés -->
                    <Border Grid.Row="1" Background="#F1F8E9" CornerRadius="8"
                            BorderBrush="#A5D6A7" BorderThickness="1"
                            Padding="10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Kezelés" FontSize="15"
                                    FontWeight="Bold" Foreground="#2E7D32"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#44546A"
                                    Text="Csökkenti a kijelölt város fertőzöttségét 15 százalékponttal. Kutatóvárosban olcsóbb (2 AP)."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="txtKezelesKoltseg" Text="Költség: 3 AP"
                                    FontSize="12" Foreground="#2E7D32" FontWeight="SemiBold"/>
                                <Button x:Name="btnKezeles" Content="Kezelés"
                                    Background="#4CAF50" Foreground="White"
                                    BorderBrush="#2E7D32" Click="BtnKezeles_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Karantén -->
                    <Border Grid.Row="2" Background="#F1F8E9" CornerRadius="8"
                            BorderBrush="#A5D6A7" BorderThickness="1"
                            Padding="10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Karantén" FontSize="15"
                                    FontWeight="Bold" Foreground="#2E7D32"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#44546A"
                                    Text="A város fertőzése lassabban terjed a következő körökben."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="txtKarantenKoltseg" Text="Költség: 5 AP"
                                           FontSize="12" Foreground="#2E7D32" FontWeight="SemiBold"/>
                                <Button x:Name="btnKaranten" Content="Karantén"
                                        Background="#4CAF50" Foreground="White"
                                        BorderBrush="#2E7D32" Click="BtnKaranten_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--Védelem-->
                    <Border Grid.Row="3" Background="#F1F8E9" CornerRadius="8"
                            BorderBrush="#A5D6A7" BorderThickness="1"
                            Padding="10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Védelem fejlesztése" FontSize="15"
                                           FontWeight="Bold" Foreground="#2E7D32"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#44546A"
                                           Text="Növeli a város védekezőképességét, így csökkentve a fertőzés terjedését."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="txtVedelem" Text="Költség: 4 AP"
                                           FontSize="12" Foreground="#2E7D32" FontWeight="SemiBold"/>
                                <Button x:Name="btnVedelem" Content="Védelem"
                                        Background="#4CAF50" Foreground="White"
                                        BorderBrush="#2E7D32" Click="BtnVedelem_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 4. ALSÓ SÁV: NAPLÓ + JÁTÉKINFÓ ==================== -->
        <Grid Grid.Row="3" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <!-- Eseménynapló ListBox-al -->
            <Border Grid.Column="0" Background="#162238" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📜 Eseménynapló" FontSize="15"
                                   FontWeight="Bold" Foreground="#9FB3CC"/>
                        <Button Grid.Column="1" Content="Napló törlése"
                                Padding="8,2" FontSize="12"
                                Background="#22334E" Foreground="#C9D6E5"
                                BorderBrush="#3A5075"
                                Click="BtnNaploTorles_Click"/>
                    </Grid>

                    <ListBox x:Name="lbEsemenyek" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#E6EDF5" FontSize="13"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Grid>
            </Border>

            <!-- Játékinformáció -->
            <Border Grid.Column="1" Background="#162238" CornerRadius="8"
                    Padding="12" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="ℹ Játékinformáció" FontSize="15"
                               FontWeight="Bold" Foreground="#9FB3CC"/>

                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#C9D6E5" FontSize="12">
                        <Run Text="🎯 Cél:" FontWeight="Bold"/>
                        <LineBreak/>
                        <Run Text="Állítsd meg a járványt! Győzöl, ha minden város fertőzöttsége 0%."/>
                    </TextBlock>

                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#C9D6E5" FontSize="12">
                        <Run Text="💀 Vereség:" FontWeight="Bold"/>
                        <LineBreak/>
                        <Run Text="Ha minden város fertőzöttsége eléri a 100%-ot."/>
                    </TextBlock>

                    <TextBlock Margin="0,8,0,0" Foreground="#C9D6E5" FontSize="12" TextWrapping="Wrap">
                        <Run Text="🏆 Pontszám = 1000 – körök × 20 + akciópont × 5" FontWeight="Bold"/>
                    </TextBlock>

                    <TextBlock x:Name="txtHelyzet" Margin="0,12,0,0"
                               Text="Járványhelyzet: –"
                               FontSize="14" FontWeight="Bold" Foreground="#FBC02D"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 5. ÁLLAPOTSÁV ==================== -->
        <Border Grid.Row="4" Background="#22334E" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Outbreak Defender v1.0" Foreground="#9FB3CC"
                               FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="  |  Készítette: Diákprojekt" Foreground="#9FB3CC"
                               FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Text="  |  WPF" Foreground="#9FB3CC"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="txtNehezseg" Grid.Column="2"
                           Text="Nehézség: Normál"
                           Foreground="#9FB3CC" FontSize="12"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
